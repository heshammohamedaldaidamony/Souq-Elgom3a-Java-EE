# ============================================================
# Souq Elgom3a — mail configuration (EXAMPLE)
# ============================================================
# Copy this file to mail.properties and fill in your own values.
# ============================================================

# ---- SMTP server ----
mail.smtp.host=smtp.gmail.com
mail.smtp.port=587
mail.smtp.auth=true
mail.smtp.starttls=true

# ---- Credentials ----
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
# 2-Factor Authentication must be enabled on the account first.
mail.smtp.username=your-email@gmail.com
mail.smtp.password=your-16-char-app-password
mail.from=Souq Elgom3a <your-email@gmail.com>

# ---- Application base URL (used in reset-password links) ----
app.base.url=http://localhost:8081/Souq-Elgom3a-Java-EE